# ==========================================
# ⚠️  ARQUIVO .env.example - TEMPLATE SEGURO
# ==========================================
#
# Este arquivo serve como REFERÊNCIA para as variáveis de ambiente necessárias.
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA comite .env.local no Git!
#
# ==========================================

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================

# URL do seu projeto Supabase (obtém em Settings > API > Project URL)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave anônima (pública) - pode ficar visível no código
# Obtém em Settings > API > Project API keys > Anon (public)
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxx"

# ⚠️  TOKEN DE SERVIÇO (SECRETO) - NUNCA COMITE!
# Token com acesso total ao banco de dados
# Obtém em Settings > API > Project API keys > Service role (secret)
# Guarde em segurança - ONLY em .env.local
SUPABASE_TOKEN="sb_secret_xxxxxxxxxxxxx"

# ==========================================
# GEMINI AI CONFIGURATION
# ==========================================

# ⚠️  CHAVE DA API DO GEMINI - NUNCA COMITE!
# Obtém em Google AI Studio: https://aistudio.google.com/app/apikey
# Limite: $300/mês grátis, depois cobra
# Guarde em segurança - ONLY em .env.local
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxx"

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# URL da aplicação em desenvolvimento
APP_URL="http://localhost:3000"

# ==========================================
# INSTRUÇÕES DE SETUP
# ==========================================
#
# 1. Copie este arquivo para .env.local:
#    cp .env.example .env.local
#
# 2. Preencha com seus valores reais:
#    - Abra seu projeto Supabase
#    - Vá em Settings > API
#    - Copie os valores necessários
#
# 3. Para Gemini API:
#    - Acesse https://aistudio.google.com/app/apikey
#    - Crie uma chave de API
#
# 4. NUNCA comite .env.local:
#    - O arquivo .gitignore já está configurado
#    - Verifique: cat .gitignore | grep .env
#
# ==========================================
